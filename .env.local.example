# Supabase 프로젝트 설정 → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role 키 (절대 클라이언트에 노출 금지 / 서버 라우트에서만 사용)
# 관리자가 직원 계정을 생성·삭제할 때 필요합니다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 휴대폰번호를 Supabase Auth 이메일로 변환할 때 쓰는 내부 도메인 (아무 값이나 가능, 실제 메일 발송 없음)
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=bigpicture.local
